{
  "name": "mezonk",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm test:contracts && pnpm --filter web test",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "indexer": "pnpm --filter web indexer",
    "abi": "node scripts/export-abi.mjs"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "uuid@<11.1.1": ">=11.1.1",
      "postcss@<8.5.10": ">=8.5.10",
      "sharp@<0.35.0": ">=0.35.0",
      "decode-uri-component@<0.5.0": ">=0.5.0",
      "undici@<6.28.1": "6.28.1",
      "@fastify/busboy@<3.2.2": "3.2.2"
    }
  }
}
