# ─────────────────────────────────────────────────────────────────────────────
# MEZONK environment. Copy to apps/web/.env.local (local) or set in your host (Vercel).
# Never commit real values. NEXT_PUBLIC_* values are visible in the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network (browser + server) ───────────────────────────────────────────────
# 31611 = Mezo Testnet (default). 31612 = Mezo mainnet (also needs NEXT_PUBLIC_ENABLE_MAINNET=true).
NEXT_PUBLIC_CHAIN_ID=31611
# Deployed MezonkExchange address. The factory, resolution and incentives contracts are derived from it.
# Leave empty and the app runs read-only with "trading off" notices.
NEXT_PUBLIC_MARKETS_ADDRESS=
# Block the contract was deployed in (indexer starts here). From the deploy script output.
NEXT_PUBLIC_MARKETS_DEPLOY_BLOCK=
# Optional: RPC the browser uses. Defaults to https://rpc.test.mezo.org. Must be public-safe (no secret key in URL).
NEXT_PUBLIC_RPC_URL=
# Optional: enables WalletConnect + mobile wallets. Free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Mainnet guard. Keep false until audit, legal review and explicit sign-off.
NEXT_PUBLIC_ENABLE_MAINNET=false

# ── Server only ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS…). Empty → embedded PGlite in apps/web/.pglite (local only).
DATABASE_URL=
# Optional private RPC for the backend/indexer (may contain an API key; never exposed to the browser).
MEZO_RPC_URL=
# Secret for GET /api/cron/index (Authorization: Bearer <CRON_SECRET>). Use a long random string.
CRON_SECRET=

# ── Indexer ──────────────────────────────────────────────────────────────────
# embedded = run inside the Next.js server (local dev with PGlite). Leave empty in production
# and use the cron route or `pnpm indexer` worker instead.
INDEXER_MODE=
INDEXER_INTERVAL_MS=4000
INDEXER_CONFIRMATIONS=2
INDEXER_MAX_BLOCKS_PER_TICK=50000

# ── Contract deployment (forge script, local shell only; never in the web host) ──
# Use a Foundry keystore (`cast wallet import deployer --interactive`) instead of a raw key.
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
OWNER=
ARBITRATOR=
RESOLVER=
# Required for signature-bound market approvals (see docs/ROLE_MANAGEMENT.md). Must differ from RESOLVER and ARBITRATOR.
CURATOR=
# Optional: first approved creator (publishes approved suggestions). Can also be granted later from /admin.
CREATOR=
# Optional first-policy overrides for DeployExchange.s.sol (POLICY_MIN_BID_DEPTH, POLICY_SEEDING_PERIOD, POLICY_TAKER_FEE_BPS, ...).

# ── Wallet sessions, roles, media (server only) ──────────────────────────────
# Sessions are random tokens stored hashed in the database (HttpOnly cookie). No signing secret is needed.
#
# One-time administrator bootstrap (comma-separated). A listed wallet becomes ADMINISTRATOR once, when it signs
# in, while the bootstrap is open. It closes on the first grant/revoke in /admin or via "Close bootstrap".
# Any malformed entry disables it. Remove it afterwards. The first wallet to connect never becomes admin.
INITIAL_ADMIN_WALLETS=

# Image storage for avatars and market images.
#   Production: set BLOB_READ_WRITE_TOKEN (Vercel Blob). Without it, uploads fail with a setup error.
#   Local/dev: files go to MEDIA_DIR (default apps/web/.media) and are served by /api/media/{id}.
#   MEDIA_STORAGE=local forces local disk in production (single-server hosts with a persistent volume only).
BLOB_READ_WRITE_TOKEN=
MEDIA_STORAGE=
MEDIA_DIR=
